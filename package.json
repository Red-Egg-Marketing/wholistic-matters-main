{
  "name": "inherited-theme",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "foundation-sites": "~6.8.1"
  },
  "overrides": {
    "chokidar": "^3.6.0"
  },
  "scripts": {
    "bs": "browser-sync start --config bs-config.js",
    "watch": "sass -w assets/scss/custom.scss:assets/css/custom.css --quiet-deps --source-map --style=compressed",
    "build:css": "sass assets/scss/:assets/css/ --quiet-deps --style=compressed && postcss --use autoprefixer -r assets/css/*.css --no-map",
    "build:fn-js": "webpack --config webpack.config.js"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ],
  "devDependencies": {
    "@babel/core": "^7.23.2",
    "@babel/preset-env": "^7.23.2",
    "autoprefixer": "^10.5.0",
    "babel-loader": "^9.1.3",
    "browser-sync": "^3.0.4",
    "postcss": "^8.5.15",
    "postcss-cli": "^11.0.1",
    "sass": "^1.100.0",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  }
}